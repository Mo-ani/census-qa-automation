{
  "info": {
    "name": "Census App",
    "description": "Requests for the Census QA challenge app (http://localhost:3000).\n\n**Start with Auth / Login.** The app answers with a session cookie; Postman stores it and sends it with every later request, so no token has to be copied. The session lasts 2 hours.\n\nThe collection can also be run top to bottom with the Collection Runner: it registers the user if needed, logs in, creates a household only when the user has none, adds a person, reads it back through every documented endpoint, deletes it and logs out.\n\nChange the collection variables (baseUrl, email, password) to use another test user. Use fictional data only - no real personal information.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "fake.qa.user@example.com"
    },
    {
      "key": "password",
      "value": "Fake#12345"
    },
    {
      "key": "userName",
      "value": "FAKE QA User"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "recordId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register (needed only once per user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"image\": \"/account.svg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created, or 403 when the e-mail is already registered', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('login succeeded', function () {",
                  "    pm.expect(pm.response.json().success).to.eql('Successful login.');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I (stores userId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/whoami",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "whoami"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('the session belongs to the test user', function () {",
                  "    pm.expect(body.principal.email).to.eql(pm.collectionVariables.get('email'));",
                  "});",
                  "pm.collectionVariables.set('userId', body.principal.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Household",
      "item": [
        {
          "name": "Get household of user by email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/household?email={{email}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "household"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "{{email}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 household found, or 404 when the user has none yet', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});",
                  "// Collection Runner only: skip the create request when the user already has a household.",
                  "// (Creating a second household through the API detaches the existing records of the user.)",
                  "if (pm.response.code === 200) {",
                  "    const next = 'Add record with relationship (stores recordId)';",
                  "    if (pm.execution && pm.execution.setNextRequest) {",
                  "        pm.execution.setNextRequest(next);",
                  "    } else {",
                  "        postman.setNextRequest(next);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create household (ONLY when the user has none)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"homeType\": \"APARTMENT\",\n  \"ownership\": \"RENT\",\n  \"lienholderId\": null,\n  \"address1\": \"100 FAKE Test Street\",\n  \"address2\": \"Apt 1\",\n  \"city\": \"Faketown\",\n  \"state\": \"VA\",\n  \"zip\": \"20170\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/household",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "household"
              ]
            },
            "description": "Send this only for a user without a household. Sending it again creates a second household and the existing records of the user are no longer returned."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Records",
      "item": [
        {
          "name": "Add record with relationship (stores recordId)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"relationship\": \"SPOUSE\",\n  \"firstName\": \"FAKEPostman\",\n  \"lastName\": \"FAKEPerson\",\n  \"dob\": \"03/15/1990\",\n  \"gender\": \"FEMALE\",\n  \"telephone\": \"2025550147\",\n  \"hispanic\": \"NO\",\n  \"hispanicOther\": \"\",\n  \"race\": \"WHITE\",\n  \"raceOther\": \"\",\n  \"otherStay\": \"NO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/record/relative",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "record",
                "relative"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.recordWithRelationship) {",
                  "    pm.collectionVariables.set('recordId', body.recordWithRelationship.record.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get records for user by email (path)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/record/user/email/{{email}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "record",
                "user",
                "email",
                "{{email}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('the added person is returned with the submitted values', function () {",
                  "    const id = Number(pm.collectionVariables.get('recordId'));",
                  "    const person = pm.response.json().records.find(r => r.id === id);",
                  "    pm.expect(person, 'record ' + id).to.be.an('object');",
                  "    pm.expect(person.firstName).to.eql('FAKEPostman');",
                  "    pm.expect(person.lastName).to.eql('FAKEPerson');",
                  "    pm.expect(person.dob).to.eql('1990-03-15T00:00:00.000Z');",
                  "    pm.expect(person.gender).to.eql('FEMALE');",
                  "    pm.expect(person.telephone).to.eql('2025550147');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get records for user by query - email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/record/user?email={{email}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "record",
                "user"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "{{email}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get records for user by query - id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/record/user?id={{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "record",
                "user"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "{{userId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get records for user - no query parameter (403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/record/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "record",
                "user"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test('the error explains what is missing', function () {",
                  "    pm.expect(pm.response.json().error)",
                  "        .to.eql('At least one query parameter required, id or email');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get records with relationship",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/record/relative?email={{email}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "record",
                "relative"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "{{email}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('the added person has the relationship SPOUSE', function () {",
                  "    const id = Number(pm.collectionVariables.get('recordId'));",
                  "    const entry = pm.response.json().recordsWithRelationship.find(e => e.record.id === id);",
                  "    pm.expect(entry.relative.relationship).to.eql('SPOUSE');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get record by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/record/id/{{recordId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "record",
                "id",
                "{{recordId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete record by id",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/record/id/{{recordId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "record",
                "id",
                "{{recordId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201 (this app answers a successful delete with 201)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Sign out",
      "item": [
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get records after logout (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/record/user/email/{{email}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "record",
                "user",
                "email",
                "{{email}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
